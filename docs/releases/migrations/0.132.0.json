  "optionalMigrations": [
    {
      "command": "tautline base-health --target . --json",
      "description": "Declare which workflow is the integration branch's post-merge acceptance suite: `postMergeTier: {workflow: <file-or-name>}` (branch defaults to the integration branch; enforcement defaults to advise). Then `tautline base-health --target .` reports whether the branch you are merging INTO is red. Leave the key absent to opt out entirely.",
      "id": "declare-the-post-merge-tier",
      "surface": "adapter-postMergeTier"
    },
    {
      "command": "tautline base-health --target . --json",
      "description": "Set postMergeTier.enforcement=block so `tautline merge` and the pre-push hook REFUSE while the base's post-merge tier is red, released only by the pushing/merging worktree's live claim (`base-red claim:`); merge alone also accepts a recorded --override. Run one release under advise first and read the `base_health_would_refuse` lines before arming.",
      "id": "arm-the-post-merge-tier-gate",
      "surface": "adapter-postMergeTier"
    },
    {
      "id": "declare-agents-and-roles",
      "summary": "Declare `agents` and `roles` explicitly instead of relying on the legacy vendor-named keys. The compat shim infers them until 1.0.0, and `tautline methodology-status` prints what it inferred and what supersedes each legacy key."
    },
    {
      "id": "declare-runtime-capabilities",
      "summary": "If your builder runs in a harness the framework has not shipped a capability list for, declare it under `runtimeCapabilities` so the enforcement report reflects what that harness actually supplies. An undeclared runtime is reported as zero-capable, which is the safe default rather than the intended path. Whole-entry replacement per runtime: your list REPLACES the shipped one, so a harness that dropped a hook can say so."
    }
  ],
  "productsTested": [],
  "requiredMigrations": [
    {
      "command": "tautline sync-methodology --target .",
      "description": "Run this FIRST. The hook's CLI path is baked by whichever install runs install-hooks, so reinstalling from an install that predates 0.49.0 rewrites the hook with the old resolver and reports success.",
      "id": "sync-the-install-before-reinstalling-hooks",
      "surface": "framework-install"
    },
    {
      "command": "<methodology_repo>/bin/tautline install-hooks --target .",
      "description": "Then rewrite the hook FROM THE UPDATED CHECKOUT. The command is path-qualified on purpose: an unqualified `tautline` resolves from PATH, which may be the stale install this migration exists to route around, and run there it rewrites the hook with the OLD resolver and reports success. An adopter lane with no framework checkout uses `tautline install-hooks --target .`, which is safe there because the step above already updated the install that `tautline` resolves to. `lane-start` performs the same rewrite.",
      "id": "reinstall-hooks-for-the-resolver-order",
      "surface": "git-hooks"
    },
    {
      "command": "tautline backlog-provider-board-check --target .",
      "description": "A board larger than the 5000-item read ceiling now REFUSES rather than silently returning a partial page. On 'board read truncated at N of M', narrow backlogProvider.scopeQuery so the read fits. Boards under the ceiling need no action.",
      "id": "narrow-scope-query-if-a-board-read-refuses",
      "surface": "board-provider"
    },
    {
      "command": "python3 --version",
      "description": "Carried forward from 0.36.0: the declared Python floor is 3.12.",
      "id": "python-312-floor",
      "surface": "runtime"
    },
    {
      "command": "tautline test-run --target .",
      "description": "Carried forward from 0.38.0: testEvidence.enforcement defaults to `block`, and a lane with no tautline-test-run/v1 record classifies `missing`.",
      "id": "record-a-test-run",
      "surface": "test-evidence"
    },
    {
      "command": "tautline install-hooks --target .",
      "description": "methodology-status --fail-on-drift requires the fleet-guard-hook PreToolUse entry. Carried forward from 0.17.0; lane-start also repairs it.",
      "id": "install-fleet-guard-hook",
      "surface": "claude-hooks"
    },
    {
      "command": "gh auth refresh --hostname github.com -s read:project -s project",
      "description": "Carried forward from 0.10.3 for lanes updating across it: grant the gh token the GitHub Projects scopes the fail-closed board gates need.",
      "id": "grant-gh-project-scopes",
      "surface": "board-provider-auth"
    },
    {
      "command": "tautline install-hooks",
      "description": "Reinstall hooks so the AskUserQuestion PreToolUse guard is registered: `tautline install-hooks` (settings-managed lanes) or the next `tautline lane-start`, which installs it automatically. Plugin installs pick it up from the refreshed plugin manifest. Until a lane does this the guard is absent, not advisory -- an uninstalled hook reports nothing at all.",
      "id": "install-question-guard-hook",
      "surface": "claude-hooks"
    },
    {
      "command": "tautline install-claude-launcher --name <your-launcher-name> --operator-channel <channel> --runtime <checkout>",
      "description": "ONLY for machines that run an operator launcher created with `--operator-channel`. That launcher now exports a DEDICATED `*_METHODOLOGY_OPERATOR_CHANNEL` signal, and the new checkout reconciliation stands down for it. Until the launcher is regenerated the session does not carry that export, so a session whose checkout sits on another channel's release branch will see `framework_checkout_reconciliation: required` and `methodology-status --fail-on-drift` will exit 2. Regenerate the launcher, or use the one-shot `--allow-non-main` / MINERVIT_METHODOLOGY_ALLOW_NON_MAIN=1 deviation in the meantime. PASS THE LAUNCHER'S OWN `--name`, and keep the `--bin-dir`/`--runtime` you originally used: the default name is the reserved managed-launcher name and the operator install refuses it, so a bare re-run exits before writing and the old launcher never gains the signal. The generic auto-rescue opt-out is deliberately NOT accepted as checkout ownership -- it is a safety setting any managed session may hold, and honouring it would bypass the very contradiction this release exists to catch.",
      "id": "reinstall-the-operator-launcher-for-its-channel-signal",
      "surface": "launcher"
    },
    {
      "command": "tautline methodology-status --target . --fail-on-drift",
      "description": "If your framework checkout sits on ANOTHER channel's release branch (channel `stable` with the checkout on `experimental`, or the reverse), resolve it rather than carrying the warning: arm maintainer mode if this machine develops the framework (`tautline maintainer-mode on`), check out the channel's release branch and re-sync, or repoint the channel with `tautline set-framework-channel <channel> --target .`. A one-shot deviation is MINERVIT_METHODOLOGY_ALLOW_NON_MAIN=1. Feature branches and detached HEAD are advisory and need no action.",
      "id": "reconcile-a-contradicting-framework-checkout",
      "surface": "framework-checkout"
    },
    {
      "command": "tautline install-hooks --target .",
      "description": "The pre-push hook gains an unconditional `base-health --boundary pre-push` step. An installed hook without it is reported missing by `git_branch_liveness_hook_state`; `tautline install-hooks --target .` or the next `lane-start` rewrites it. Until then the boundary re-check does not run on that checkout -- absent, not advisory.",
      "id": "reinstall-hooks-for-base-health",
      "surface": "git-hooks"
    },
    {
      "command": "tautline install-hooks --target .",
      "description": "Run `tautline install-hooks --target .` (or `lane-start`) in every checkout. The two portable gates reach a machine only when its pre-commit hook is rewritten, and the gap is silent from inside the lane.",
      "id": "reinstall-hooks-for-portable-gates",
      "surface": "git-hooks"
    }
  ],
  "rollbackNotes": [
    "Reverting pins ruff back to 0.15.21. No adapter key changes and no configuration moves in either direction."
  ],
  "schema": "minervit-release-migration-report/v1",
  "version": "0.132.0",
  "wipSafe": true
}
