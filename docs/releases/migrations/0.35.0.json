  "optionalMigrations": [
    {
      "command": "tautline merge <pr> --squash --delete-branch",
      "description": "Set mergeGate.enforcement=block so `tautline merge` REFUSES a PR whose live checks are failing or still running, and merge through the verb instead of raw `gh pr merge`. Do this on any repo where ci-health-check reports platform_required_checks: absent or unavailable -- there, CI gates nothing and this verb is the only thing between a red commit and the integration branch. Default stays `advise`.",
      "id": "arm-the-client-side-merge-gate",
      "surface": "adapter-mergeGate"
    }
  ],
  "productsTested": [],
  "requiredMigrations": [
    {
      "command": "tautline install-hooks --target .",
      "description": "methodology-status --fail-on-drift requires the fleet-guard-hook PreToolUse entry (matcher Edit|Write|MultiEdit|NotebookEdit). Carried forward from 0.17.0; lane-start also repairs it, including a stale narrower matcher.",
      "id": "install-fleet-guard-hook",
      "surface": "claude-hooks"
    },
    {
      "command": "gh auth refresh --hostname github.com -s read:project -s project",
      "description": "Carried forward from 0.10.3 for lanes updating across it: grant the gh token the GitHub Projects scopes the fail-closed board gates need. Machines already on 0.10.3+ or whose token carries read:project and project need no action.",
      "id": "grant-gh-project-scopes",
      "surface": "board-provider-auth"
    }
  ],
  "rollbackNotes": [
    "Repinning below 0.35.0 removes the merge verb and ignores mergeGate; merges go back to raw `gh pr merge` with no check verification. On a repo without platform enforcement that is a GATE LOSS, not a neutral change.",
    "The 0.34.0 kernel remains, uncalled, so repinning to 0.34.0 leaves dead but harmless code rather than a broken import.",
    "install-fleet-guard-hook and grant-gh-project-scopes are carried forward (see requiredMigrations) because framework_update_decision reads only the LATEST report."
  ],
  "schema": "minervit-release-migration-report/v1",
  "version": "0.35.0",
  "wipSafe": true
}
