  "optionalMigrations": [],
  "productsTested": [],
  "requiredMigrations": [
    {
      "command": "tautline install-hooks --target .",
      "description": "methodology-status --fail-on-drift now requires the fleet-guard-hook PreToolUse entry (matcher Edit|Write|MultiEdit|NotebookEdit). Existing settings-managed installs report drift until rewritten. Any lane-start also repairs it on the way through, including a stale narrower matcher.",
      "id": "install-fleet-guard-hook",
      "surface": "claude-hooks"
    },
    {
      "command": "gh auth refresh --hostname github.com -s read:project -s project",
      "description": "Carried forward from 0.10.3 for lanes updating across it: grant the gh token the GitHub Projects scopes the fail-closed board gates need. Machines already on 0.10.3+ or whose token carries read:project and project need no action.",
      "id": "grant-gh-project-scopes",
      "surface": "board-provider-auth"
    }
  ],
  "rollbackNotes": [
    "Repinning below 0.17.0 removes the fleet verbs, the guard hook, and the `fleet` adapter domain. Lease state lives inside .git/tautline-fleet/ and is untracked, so nothing needs migrating; stale lease files are simply ignored once the reader is gone, and may be deleted.",
    "The fleet-guard-hook entry left in ~/.claude/settings.json by a newer build becomes an inert reference to a verb that no longer exists; the hook fail-opens, so edits are unaffected. Remove it with `tautline install-hooks` on the repinned version.",
    "grant-gh-project-scopes is carried forward from 0.10.3 (see requiredMigrations); a lane already on 0.10.3+ needs no action.",
    "NOT WIP-safe only for the engine-gap carry-forward; the release's own change is additive and inert in single-lane checkouts."
  ],
  "schema": "minervit-release-migration-report/v1",
  "version": "0.17.0",
  "wipSafe": false
}
