  "optionalMigrations": [],
  "productsTested": [],
  "requiredMigrations": [
    {
      "command": "python3 --version",
      "description": "Carried forward from 0.36.0: the declared Python floor is 3.12. Nothing in the tree ever REQUIRED 3.10 -- it parses under the 3.9 grammar and the old floor rested on zip(strict=), present in 3.10+ -- so this is a support-window change, not a syntax one. A lane on 3.10/3.11 must upgrade its interpreter; nothing else changes.",
      "id": "python-312-floor",
      "surface": "runtime"
    },
    {
      "command": "tautline test-run --target .",
      "description": "Carried forward from 0.38.0: testEvidence.enforcement defaults to `block`, and a lane with no tautline-test-run/v1 record classifies `missing`. Run the gate once so the tree has a record; after that the record is refreshed by running it again whenever the tree changes. A lane that is not ready for this sets testEvidence.enforcement to `warn` or `off` in its SOURCE adapter and re-renders -- deliberately, with a decision record.",
      "id": "record-a-test-run",
      "surface": "test-evidence"
    },
    {
      "command": "tautline install-hooks --target .",
      "description": "methodology-status --fail-on-drift requires the fleet-guard-hook PreToolUse entry (matcher Edit|Write|MultiEdit|NotebookEdit). Carried forward from 0.17.0; lane-start also repairs it, including a stale narrower matcher.",
      "id": "install-fleet-guard-hook",
      "surface": "claude-hooks"
    },
    {
      "command": "gh auth refresh --hostname github.com -s read:project -s project",
      "description": "Carried forward from 0.10.3 for lanes updating across it: grant the gh token the GitHub Projects scopes the fail-closed board gates need.",
      "id": "grant-gh-project-scopes",
      "surface": "board-provider-auth"
    }
  ],
  "rollbackNotes": [
    "Repinning below 0.38.3 removes the three archive entries and the changelog-coverage test. No state migration in either direction -- the change is documentation plus one assertion, and stores nothing.",
    "WIP-safe: adopter lanes are untouched. Nothing here changes a runtime path.",
    "The 21 remaining gap versions are unaffected by a rollback in either direction; they are recoverable only from the private pre-launch repository."
  ],
  "schema": "minervit-release-migration-report/v1",
  "version": "0.38.3",
  "wipSafe": true
