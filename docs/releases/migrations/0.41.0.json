  "productsTested": [],
  "requiredMigrations": [
    {
      "command": "python3 --version",
      "description": "Carried forward from 0.36.0: the declared Python floor is 3.12. A lane on 3.10/3.11 must upgrade its interpreter; nothing else changes.",
      "id": "python-312-floor",
      "surface": "runtime"
    },
    {
      "command": "tautline test-run --target .",
      "description": "Carried forward from 0.38.0: testEvidence.enforcement defaults to `block`, and a lane with no tautline-test-run/v1 record classifies `missing`. Run it once so the tree has a record. A lane not ready for this sets testEvidence.enforcement to `warn` or `off` in its SOURCE adapter and re-renders -- deliberately, with a decision record.",
      "id": "record-a-test-run",
      "surface": "test-evidence"
    },
    {
      "command": "tautline install-hooks --target .",
      "description": "methodology-status --fail-on-drift requires the fleet-guard-hook PreToolUse entry (matcher Edit|Write|MultiEdit|NotebookEdit). Carried forward from 0.17.0; lane-start also repairs it.",
      "id": "install-fleet-guard-hook",
      "surface": "claude-hooks"
    },
    {
      "command": "gh auth refresh --hostname github.com -s read:project -s project",
      "description": "Carried forward from 0.10.3 for lanes updating across it: grant the gh token the GitHub Projects scopes the fail-closed board gates need.",
      "id": "grant-gh-project-scopes",
      "surface": "board-provider-auth"
    }
  ],
  "rollbackNotes": [
    "Repinning below 0.41.0 restores the pre-carve cli.py; the carve writes no state and the alias layer means adopter code never observes which side of the split a symbol lives on.",
    "WIP-safe: adopter lanes are untouched; the moved code is behaviour-identical by construction and the full gate ran green on the carved tree."
  ],
