  "optionalMigrations": [],
  "productsTested": [
    "Tautline self-hosted CI runner; suite green 4422/4422 fresh-checkout; runner registered, online, destroy and re-register cycle exercised"
  ],
  "requiredMigrations": [
    {
      "command": "tautline install-hooks --target .",
      "description": "methodology-status --fail-on-drift requires the fleet-guard-hook PreToolUse entry (matcher Edit|Write|MultiEdit|NotebookEdit). Carried forward from 0.17.0; lane-start also repairs it, including a stale narrower matcher.",
      "id": "install-fleet-guard-hook",
      "surface": "claude-hooks"
    },
    {
      "command": "gh auth refresh --hostname github.com -s read:project -s project",
      "description": "Carried forward from 0.10.3 for lanes updating across it: grant the gh token the GitHub Projects scopes the fail-closed board gates need. Machines already on 0.10.3+ or whose token carries read:project and project need no action.",
      "id": "grant-gh-project-scopes",
      "surface": "board-provider-auth"
    }
  ],
  "rollbackNotes": [
    "Clearing the CI_RUNNER_LABEL repo variable reverts runner selection to ubuntu-latest with no code change; repinning below 0.35.3 additionally restores billing for superseded PR runs. No state migration in either direction.",
    "install-fleet-guard-hook and grant-gh-project-scopes are carried forward (see requiredMigrations) because framework_update_decision reads only the LATEST report."
  ],
  "schema": "minervit-release-migration-report/v1",
  "version": "0.35.3",
  "wipSafe": true
}
