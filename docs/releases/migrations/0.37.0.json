  "optionalMigrations": [
    {
      "command": "tautline validate-adapter --project .tautline/adapter.json",
      "description": "The review.roundBudgets DEFAULT moves from {T0:0,T1:1,T2:2,T3:2} to {T0:0,T1:2,T2:3,T3:4}. A project that pins review.roundBudgets explicitly is unaffected. A project relying on the default gets the new values on update: that is the intent, but pin the old shape here if a lane needs the previous ceilings for a release in flight.",
      "id": "review-round-budgets-explicit-pin",
      "surface": "adapter-review"
    }
  ],
  "productsTested": [],
  "requiredMigrations": [
    {
      "command": "python3 --version",
      "description": "Carried forward from 0.36.0: the declared Python floor is 3.12. Nothing in the tree ever REQUIRED 3.10 -- it parses under the 3.9 grammar and the old floor rested on zip(strict=), present in 3.10+ -- so this is a support-window change, not a syntax one. A lane on 3.10/3.11 must upgrade its interpreter; nothing else changes.",
      "id": "python-312-floor",
      "surface": "runtime"
    },
    {
      "command": "tautline install-hooks --target .",
      "description": "methodology-status --fail-on-drift requires the fleet-guard-hook PreToolUse entry (matcher Edit|Write|MultiEdit|NotebookEdit). Carried forward from 0.17.0; lane-start also repairs it, including a stale narrower matcher.",
      "id": "install-fleet-guard-hook",
      "surface": "claude-hooks"
    },
    {
      "command": "gh auth refresh --hostname github.com -s read:project -s project",
      "description": "Carried forward from 0.10.3 for lanes updating across it: grant the gh token the GitHub Projects scopes the fail-closed board gates need. Machines already on 0.10.3+ or whose token carries read:project and project need no action.",
      "id": "grant-gh-project-scopes",
      "surface": "board-provider-auth"
    }
  ],
  "rollbackNotes": [
    "Repinning below 0.37.0 restores the unconditional budget refusal and the old default budgets. There is no state migration in either direction: the ladder reads the same adapter key and the same Stage 2 manifests, and the confirming-round exemption is computed per invocation rather than stored.",
    "A lane that pinned review.roundBudgets explicitly sees no change in either direction.",
    "install-fleet-guard-hook and grant-gh-project-scopes are carried forward (see requiredMigrations) because framework_update_decision reads only the LATEST report.",
    "WIP-safe: the change only ever ADDS legal paths for a lane mid-review. A lane already inside budget behaves identically."
  ],
  "schema": "minervit-release-migration-report/v1",
  "version": "0.37.0",
  "wipSafe": true
}
