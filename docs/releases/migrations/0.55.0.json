  "optionalMigrations": [],
  "productsTested": [],
  "requiredMigrations": [
    {
      "command": "tautline sync-methodology --target .",
      "description": "Run this FIRST. The hook's CLI path is baked by whichever install runs install-hooks, so reinstalling from an install that predates 0.49.0 rewrites the hook with the old resolver and reports success.",
      "id": "sync-the-install-before-reinstalling-hooks",
      "surface": "framework-install"
    },
    {
      "command": "<methodology_repo>/bin/tautline install-hooks --target .",
      "description": "Then rewrite the hook FROM THE UPDATED CHECKOUT. The command is path-qualified on purpose: an unqualified `tautline` resolves from PATH, which may be the stale install this migration exists to route around, and run there it rewrites the hook with the OLD resolver and reports success. An adopter lane with no framework checkout uses `tautline install-hooks --target .`, which is safe there because the step above already updated the install that `tautline` resolves to. `lane-start` performs the same rewrite.",
      "id": "reinstall-hooks-for-the-resolver-order",
      "surface": "git-hooks"
    },
    {
      "command": "tautline backlog-provider-board-check --target .",
      "description": "A board larger than the 5000-item read ceiling now REFUSES rather than silently returning a partial page. On 'board read truncated at N of M', narrow backlogProvider.scopeQuery so the read fits. Boards under the ceiling need no action.",
      "id": "narrow-scope-query-if-a-board-read-refuses",
      "surface": "board-provider"
    },
    {
      "command": "python3 --version",
      "description": "Carried forward from 0.36.0: the declared Python floor is 3.12.",
      "id": "python-312-floor",
      "surface": "runtime"
    },
    {
      "command": "tautline test-run --target .",
      "description": "Carried forward from 0.38.0: testEvidence.enforcement defaults to `block`, and a lane with no tautline-test-run/v1 record classifies `missing`.",
      "id": "record-a-test-run",
      "surface": "test-evidence"
    },
    {
      "command": "tautline install-hooks --target .",
      "description": "methodology-status --fail-on-drift requires the fleet-guard-hook PreToolUse entry. Carried forward from 0.17.0; lane-start also repairs it.",
      "id": "install-fleet-guard-hook",
      "surface": "claude-hooks"
    },
    {
      "command": "gh auth refresh --hostname github.com -s read:project -s project",
      "description": "Carried forward from 0.10.3 for lanes updating across it: grant the gh token the GitHub Projects scopes the fail-closed board gates need.",
      "id": "grant-gh-project-scopes",
      "surface": "board-provider-auth"
    }
  ],
  "rollbackNotes": [
    "Repinning below 0.55.0 removes the `--base` flag and its report lines, and restores the shorter `behavior_specs_instruction:` line. No state migration in either direction: nothing is written, no adapter key is read, and no gate or exit code changed, so a lane on either side of the pin gets the same refusals.",
    "WIP-safe: the release adds an opt-in report and removes a duplicate scan; a lane in progress that never passes `--base` sees no behavior change."
  ],
  "schema": "minervit-release-migration-report/v1",
  "version": "0.55.0",
  "wipSafe": true
}
