#!/usr/bin/env python3
"""NON-conforming agent: transport failure.

Writes nothing and exits 3. This is what a genuine transport failure looks like, and the seam
must distinguish it from findings: no manifest may be recorded for a review that never ran."""
import json
import os
import sys

AGENT_ID = os.environ.get("TAUTLINE_REVIEW_AGENT_ID", "fixture-nonzero")
path = os.environ.get("TAUTLINE_REVIEW_RESULT_PATH")
if not path:
    print("no TAUTLINE_REVIEW_RESULT_PATH supplied", file=sys.stderr)
    raise SystemExit(2)  # transport failure: the framework did not hold up its end

print("wrapper could not reach the model", file=sys.stderr)
raise SystemExit(3)
